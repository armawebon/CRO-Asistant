# Copia este fichero a .env y rellena los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# --- Modelo (obligatorio para el modo real) --------------------------------
# Clave del API de Z.AI. Se lee solo en el servidor; el navegador nunca la recibe.
ZAI_API_KEY=

# Modelo a utilizar. Si el identificador no existe, el API devolverá un error
# y la aplicación lo mostrará tal cual para que puedas corregirlo aquí.
ZAI_MODEL=glm-5.2

# Endpoint compatible con OpenAI. Cambia a https://open.bigmodel.cn/api/paas/v4
# si usas la plataforma china (BigModel) en lugar de la internacional (Z.AI).
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Tiempo máximo de espera por llamada al modelo (ms).
ZAI_TIMEOUT_MS=180000

# --- Servidor ---------------------------------------------------------------
PORT=8080
HOST=127.0.0.1

# --- Recolección ------------------------------------------------------------
# 0 desactiva el clonado: el modelo analizaría sin evidencia recogida.
CRO_CLONAR=1
# Nº de commits a traer en el clon cuando la profundidad es "histórico completo".
CRO_PROFUNDIDAD=80
# Límites de recolección para acotar el tamaño del contexto enviado al modelo.
CRO_MAX_FICHEROS=6000
CRO_MAX_PROMPT=120000
CRO_TIMEOUT_CLONE_MS=120000
